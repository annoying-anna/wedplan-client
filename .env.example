# ---------------------------------------------------------------------------
# WedPlan Client (Next.js) — copy this file to `.env.local` for local development
# Never commit real credentials. `.env*` files are git-ignored except this example.
# ---------------------------------------------------------------------------

# Express API base URL (must include /api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public URL of this Next.js app (used by Better Auth + Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Better Auth (MongoDB adapter + JWT plugin + Google OAuth)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/wedplan
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---------------------------------------------------------------------------
# Stripe (publishable key is safe to expose; secret key belongs on the server)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ---------------------------------------------------------------------------
# ImgBB image hosting
# ---------------------------------------------------------------------------
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key
